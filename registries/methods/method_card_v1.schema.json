{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saf:method-card:v1",
  "title": "MethodCardV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method_id",
    "version",
    "title",
    "sport",
    "category",
    "status",
    "source",
    "licenses",
    "research",
    "reuse",
    "evidence_boundary",
    "content_sha256"
  ],
  "properties": {
    "method_id": {
      "type": "string",
      "pattern": "^METHOD-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sport": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "READY_FOR_LOCAL_REPRODUCTION",
        "METHOD_REFERENCE_ONLY",
        "DATA_GAP"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "source_kind",
        "observed_at",
        "precise_version",
        "primary_source",
        "provenance_notes"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_kind": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "precise_version": {
          "type": "string",
          "minLength": 1
        },
        "primary_source": {
          "const": true
        },
        "provenance_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "licenses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "data"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/licenseEvidence"
        },
        "data": {
          "$ref": "#/$defs/licenseEvidence"
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_question",
        "inputs",
        "target",
        "validation",
        "published_claims_not_evidence"
      ],
      "properties": {
        "research_question": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "type": "string",
          "minLength": 1
        },
        "published_claims_not_evidence": {
          "const": true
        }
      }
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reusable_portion",
        "independently_reproduced",
        "implementation_state",
        "local_dependencies",
        "prohibited_uses"
      ],
      "properties": {
        "reusable_portion": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "independently_reproduced": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "implementation_state": {
          "type": "string",
          "minLength": 1
        },
        "local_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_uses": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_gaps",
        "claim_boundary"
      ],
      "properties": {
        "data_gaps": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "licenseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "spdx_id",
        "evidence_url",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "spdx_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
