{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saf:vendor-sample-audit:v1",
  "title": "VendorSampleAuditV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "source_id",
    "market_ids",
    "window_start",
    "window_end",
    "raw_manifest_sha256",
    "normalized_manifest_sha256",
    "grain",
    "timestamp_evidence",
    "continuity",
    "reconstruction",
    "trade_direction",
    "license",
    "verdict"
  ],
  "properties": {
    "schema_version": {"const": "VendorSampleAuditV1"},
    "sample_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "market_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "raw_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "normalized_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "grain": {"enum": ["EVENT_DRIVEN", "INTERVAL_SNAPSHOT"]},
    "timestamp_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_clock",
        "vendor_receive_clock",
        "resolution_claim"
      ],
      "properties": {
        "source_clock": {"type": "string", "minLength": 1},
        "vendor_receive_clock": {"type": "string", "minLength": 1},
        "resolution_claim": {"type": "string", "minLength": 1}
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_snapshot",
        "gap_count",
        "duplicate_count",
        "out_of_order_count"
      ],
      "properties": {
        "initial_snapshot": {"type": "boolean"},
        "gap_count": {"type": "integer", "minimum": 0},
        "duplicate_count": {"type": "integer", "minimum": 0},
        "out_of_order_count": {"type": "integer", "minimum": 0}
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_one_sha256",
        "run_two_sha256",
        "official_reconciliation_status"
      ],
      "properties": {
        "run_one_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "run_two_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "official_reconciliation_status": {
          "enum": ["PASS", "FAIL", "NOT_AVAILABLE"]
        }
      }
    },
    "trade_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "inference_used"],
      "properties": {
        "provenance": {"type": "string", "minLength": 1},
        "inference_used": {"type": "boolean"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ref"],
      "properties": {
        "status": {"enum": ["APPROVED", "PENDING", "BLOCKED"]},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "verdict": {"enum": ["PASS", "FAIL", "PENDING"]}
  }
}
